<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>G.I. Joe Character Database</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0c0e0a;
    --panel: #161911;
    --panel-border: #2b3020;
    --joe: #8a9a5b;
    --joe-dark: #5c6a3a;
    --cobra: #c41e3a;
    --cobra-dark: #7a1023;
    --oktober: #5a8fc2;
    --oktober-dark: #2c4d6e;
    --panel-oktober: #10161d;
    --dreadnok: #d9822b;
    --dreadnok-dark: #7a4f0a;
    --panel-dreadnok: #1c150a;
    --cobra-la: #9a5ec2;
    --cobra-la-dark: #5c2f7a;
    --panel-cobra-la: #160f1c;
    --text-muted: #9aa08a;
    --panel-cobra: #1e1213;
    --neutral: #8a8f8c;
    --neutral-dark: #4c504e;
    --panel-neutral: #18191a;
    --kia: #3a1414;
    --kia-text: #d97a7a;
    --bg-cobra: #140a0b;
    --bg-oktober: #0a0e13;
    --bg-dreadnok: #130e07;
    --bg-cobra-la: #110b15;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--bg);
    color: #eef0e6;
    font-family: 'Inter', sans-serif;
    transition: background 0.4s ease;
  }

  body.bg-cobra { background: var(--bg-cobra); }
  body.bg-oktober { background: var(--bg-oktober); }
  body.bg-dreadnok { background: var(--bg-dreadnok); }
  body.bg-cobra-la { background: var(--bg-cobra-la); }

  header {
    text-align: center;
    padding: 40px 20px 28px;
    border-bottom: 2px solid var(--neutral-dark);
    background: #000;
  }

  header h1 {
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 2.4rem;
    margin: 0 0 8px;
    color: var(--joe);
  }

  .header-logo {
    display: block;
    max-width: 420px;
    width: 90%;
    height: auto;
    margin: 0 auto;
  }

  .header-subtitle {
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 1rem;
    margin: 10px 0 0;
    color: #fff;
  }

  /* Top-level section tabs */
  .tabs {
    max-width: 1000px;
    margin: 32px auto 0;
    padding: 0 20px;
    display: flex;
    gap: 8px;
    border-bottom: 2px solid var(--neutral-dark);
  }

  .tab-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    font-family: 'Oswald', sans-serif;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-size: 0.9rem;
    padding: 12px 18px;
    cursor: pointer;
    border-bottom: 3px solid transparent;
    margin-bottom: -2px;
    transition: color 0.15s, border-color 0.15s;
  }

  .tab-btn:hover { color: #eef0e6; }
  .tab-btn.active { color: var(--neutral); border-color: var(--neutral); }

  .tab-section { display: none; }
  .tab-section.active { display: block; }

  .controls {
    max-width: 1000px;
    margin: 28px auto;
    padding: 0 20px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }

  .search-input {
    flex: 1;
    min-width: 220px;
    background: var(--panel-neutral);
    border: 1px solid var(--neutral-dark);
    border-radius: 6px;
    padding: 10px 14px;
    color: #eef0e6;
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
  }

  .search-input:focus { outline: none; border-color: var(--neutral); }

  .filter-btn {
    background: var(--panel);
    border: 1px solid var(--neutral-dark);
    color: var(--text-muted);
    font-family: 'Oswald', sans-serif;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-size: 0.8rem;
    padding: 10px 16px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s;
  }

  .filter-btn:hover { border-color: var(--neutral); color: #eef0e6; }
  .filter-btn.active { background: var(--neutral-dark); border-color: var(--neutral); color: #fff; }

  .filter-btn[data-filter="G.I. Joe"]:hover, .filter-btn[data-vfilter="G.I. Joe"]:hover, .filter-btn[data-tfilter="G.I. Joe"]:hover { border-color: var(--joe); }
  .filter-btn[data-filter="G.I. Joe"].active, .filter-btn[data-vfilter="G.I. Joe"].active, .filter-btn[data-tfilter="G.I. Joe"].active { background: var(--joe-dark); border-color: var(--joe); color: #fff; }

  .filter-btn[data-filter="Cobra"]:hover, .filter-btn[data-vfilter="Cobra"]:hover, .filter-btn[data-tfilter="Cobra"]:hover { border-color: var(--cobra); }
  .filter-btn[data-filter="Cobra"].active, .filter-btn[data-vfilter="Cobra"].active, .filter-btn[data-tfilter="Cobra"].active { background: var(--cobra-dark); border-color: var(--cobra); color: #fff; }

  .filter-btn[data-filter="Oktober Guard"]:hover, .filter-btn[data-vfilter="Oktober Guard"]:hover, .filter-btn[data-tfilter="Oktober Guard"]:hover { border-color: var(--oktober); }
  .filter-btn[data-filter="Oktober Guard"].active, .filter-btn[data-vfilter="Oktober Guard"].active, .filter-btn[data-tfilter="Oktober Guard"].active { background: var(--oktober-dark); border-color: var(--oktober); color: #fff; }

  .filter-btn[data-filter="Dreadnoks"]:hover, .filter-btn[data-vfilter="Dreadnoks"]:hover, .filter-btn[data-tfilter="Dreadnoks"]:hover { border-color: var(--dreadnok); }
  .filter-btn[data-filter="Dreadnoks"].active, .filter-btn[data-vfilter="Dreadnoks"].active, .filter-btn[data-tfilter="Dreadnoks"].active { background: var(--dreadnok-dark); border-color: var(--dreadnok); color: #fff; }

  .filter-btn[data-filter="Cobra-La"]:hover, .filter-btn[data-vfilter="Cobra-La"]:hover, .filter-btn[data-tfilter="Cobra-La"]:hover { border-color: var(--cobra-la); }
  .filter-btn[data-filter="Cobra-La"].active, .filter-btn[data-vfilter="Cobra-La"].active, .filter-btn[data-tfilter="Cobra-La"].active { background: var(--cobra-la-dark); border-color: var(--cobra-la); color: #fff; }

  .grid {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 20px 60px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }

  .card {
    position: relative;
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: 10px;
    padding: 16px;
    cursor: pointer;
    transition: transform 0.15s, border-color 0.15s;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .card:hover { transform: translateY(-2px); border-color: var(--joe); }

  .kia-ribbon {
    position: absolute;
    top: 10px;
    right: 12px;
    font-family: 'Oswald', sans-serif;
    font-size: 0.6rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 4px;
    background: var(--kia);
    color: var(--kia-text);
    border: 1px solid var(--kia-text);
  }

  .field-row.kia-row .label {
    color: #b33a3a;
    font-weight: 700;
  }

  .kia-row .value {
    color: var(--kia-text);
  }

  .filecard .kia-ribbon {
    top: 14px;
    right: 14px;
  }

  .card.cobra { border-color: var(--cobra-dark); background: var(--panel-cobra); }
  .card.cobra:hover { border-color: var(--cobra); }

  .card.oktober { border-color: var(--oktober-dark); background: var(--panel-oktober); }
  .card.oktober:hover { border-color: var(--oktober); }

  .card.dreadnok { border-color: var(--dreadnok-dark); background: var(--panel-dreadnok); }
  .card.dreadnok:hover { border-color: var(--dreadnok); }

  .card.cobra-la { border-color: var(--cobra-la-dark); background: var(--panel-cobra-la); }
  .card.cobra-la:hover { border-color: var(--cobra-la); }

  .card-text { flex: 1; min-width: 0; }

  .badge {
    display: inline-block;
    font-family: 'Oswald', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 4px;
    margin-bottom: 8px;
    background: var(--joe-dark);
    color: #fff;
  }

  .card.cobra .badge { background: var(--cobra-dark); }
  .card.oktober .badge { background: var(--oktober-dark); }
  .card.dreadnok .badge { background: var(--dreadnok-dark); }
  .card.cobra-la .badge { background: var(--cobra-la-dark); }

  .card h3 {
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
    font-size: 1.15rem;
    margin: 0 0 4px;
    letter-spacing: 0.5px;
  }

  .card .specialty {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin: 0;
  }

  .card-thumb {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 8px;
    background: repeating-linear-gradient(
      45deg,
      rgba(255,255,255,0.03),
      rgba(255,255,255,0.03) 6px,
      transparent 6px,
      transparent 12px
    );
    border: 1px dashed var(--panel-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    font-size: 0.65rem;
    text-align: center;
    line-height: 1.2;
    font-family: 'Oswald', sans-serif;
    letter-spacing: 0.5px;
  }

  .card.cobra .card-thumb { border-color: var(--cobra-dark); }
  .card.oktober .card-thumb { border-color: var(--oktober-dark); }
  .card.dreadnok .card-thumb { border-color: var(--dreadnok-dark); }
  .card.cobra-la .card-thumb { border-color: var(--cobra-la-dark); }

  .card-thumb-img {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 8px;
    object-fit: cover;
    border: 1px solid var(--panel-border);
    background: var(--bg);
  }

  .card.cobra .card-thumb-img { border-color: var(--cobra-dark); }
  .card.oktober .card-thumb-img { border-color: var(--oktober-dark); }
  .card.dreadnok .card-thumb-img { border-color: var(--dreadnok-dark); }
  .card.cobra-la .card-thumb-img { border-color: var(--cobra-la-dark); }

  /* Vehicle thumbs: landscape aspect ratio instead of square */
  .vehicle-card-thumb {
    flex-shrink: 0;
    width: 104px;
    height: 64px;
    border-radius: 8px;
    background: repeating-linear-gradient(
      45deg,
      rgba(255,255,255,0.03),
      rgba(255,255,255,0.03) 6px,
      transparent 6px,
      transparent 12px
    );
    border: 1px dashed var(--panel-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    font-size: 0.65rem;
    text-align: center;
    line-height: 1.2;
    font-family: 'Oswald', sans-serif;
    letter-spacing: 0.5px;
  }

  .card.cobra .vehicle-card-thumb { border-color: var(--cobra-dark); }
  .card.oktober .vehicle-card-thumb { border-color: var(--oktober-dark); }
  .card.dreadnok .vehicle-card-thumb { border-color: var(--dreadnok-dark); }
  .card.cobra-la .vehicle-card-thumb { border-color: var(--cobra-la-dark); }

  .vehicle-card-thumb-img {
    flex-shrink: 0;
    width: 104px;
    height: 64px;
    border-radius: 8px;
    object-fit: cover;
    border: 1px solid var(--panel-border);
    background: var(--bg);
  }

  .card.cobra .vehicle-card-thumb-img { border-color: var(--cobra-dark); }
  .card.oktober .vehicle-card-thumb-img { border-color: var(--oktober-dark); }
  .card.dreadnok .vehicle-card-thumb-img { border-color: var(--dreadnok-dark); }
  .card.cobra-la .vehicle-card-thumb-img { border-color: var(--cobra-la-dark); }

  /* Modal / File card */
  .overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.75);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
    padding: 20px;
    z-index: 100;
  }

  .overlay.open { opacity: 1; pointer-events: auto; }

  .filecard {
    background: var(--panel);
    border: 2px solid var(--joe);
    border-radius: 14px;
    max-width: 560px;
    width: 100%;
    max-height: 88vh;
    overflow-y: auto;
    padding: 28px;
    position: relative;
  }

  .filecard.cobra { border-color: var(--cobra); background: var(--panel-cobra); }
  .filecard.oktober { border-color: var(--oktober); background: var(--panel-oktober); }
  .filecard.dreadnok { border-color: var(--dreadnok); background: var(--panel-dreadnok); }
  .filecard.cobra-la { border-color: var(--cobra-la); background: var(--panel-cobra-la); }

  .close-btn {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 1.4rem;
    cursor: pointer;
    line-height: 1;
  }

  .close-btn:hover { color: #fff; }

  .filecard-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 6px;
  }

  .filecard-heading { flex: 1; min-width: 0; }

  .filecard-thumb {
    flex-shrink: 0;
    width: 150px;
    height: 150px;
    border-radius: 8px;
    background: repeating-linear-gradient(
      45deg,
      rgba(255,255,255,0.04),
      rgba(255,255,255,0.04) 6px,
      transparent 6px,
      transparent 12px
    );
    border: 1px dashed var(--panel-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    font-size: 0.65rem;
    text-align: center;
    line-height: 1.3;
    font-family: 'Oswald', sans-serif;
    letter-spacing: 0.5px;
    padding: 4px;
  }

  .filecard.cobra .filecard-thumb { border-color: var(--cobra-dark); }
  .filecard.oktober .filecard-thumb { border-color: var(--oktober-dark); }
  .filecard.dreadnok .filecard-thumb { border-color: var(--dreadnok-dark); }
  .filecard.cobra-la .filecard-thumb { border-color: var(--cobra-la-dark); }

  .filecard-thumb-img {
    flex-shrink: 0;
    width: 150px;
    height: 150px;
    border-radius: 8px;
    object-fit: cover;
    border: 1px solid var(--panel-border);
    background: var(--bg);
  }

  .filecard.cobra .filecard-thumb-img { border-color: var(--cobra-dark); }
  .filecard.oktober .filecard-thumb-img { border-color: var(--oktober-dark); }
  .filecard.dreadnok .filecard-thumb-img { border-color: var(--dreadnok-dark); }
  .filecard.cobra-la .filecard-thumb-img { border-color: var(--cobra-la-dark); }

  /* Vehicle filecard thumb: landscape aspect ratio instead of square */
  .vehicle-filecard-thumb {
    flex-shrink: 0;
    width: 240px;
    height: 150px;
    border-radius: 8px;
    background: repeating-linear-gradient(
      45deg,
      rgba(255,255,255,0.04),
      rgba(255,255,255,0.04) 6px,
      transparent 6px,
      transparent 12px
    );
    border: 1px dashed var(--panel-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    font-size: 0.65rem;
    text-align: center;
    line-height: 1.3;
    font-family: 'Oswald', sans-serif;
    letter-spacing: 0.5px;
    padding: 4px;
  }

  .filecard.cobra .vehicle-filecard-thumb { border-color: var(--cobra-dark); }
  .filecard.oktober .vehicle-filecard-thumb { border-color: var(--oktober-dark); }
  .filecard.dreadnok .vehicle-filecard-thumb { border-color: var(--dreadnok-dark); }
  .filecard.cobra-la .vehicle-filecard-thumb { border-color: var(--cobra-la-dark); }

  .vehicle-filecard-thumb-img {
    flex-shrink: 0;
    width: 240px;
    height: 150px;
    border-radius: 8px;
    object-fit: cover;
    border: 1px solid var(--panel-border);
    background: var(--bg);
  }

  .filecard.cobra .vehicle-filecard-thumb-img { border-color: var(--cobra-dark); }
  .filecard.oktober .vehicle-filecard-thumb-img { border-color: var(--oktober-dark); }
  .filecard.dreadnok .vehicle-filecard-thumb-img { border-color: var(--dreadnok-dark); }
  .filecard.cobra-la .vehicle-filecard-thumb-img { border-color: var(--cobra-la-dark); }

  .filecard .badge { margin-bottom: 10px; }

  .filecard.cobra .badge { background: var(--cobra-dark); }
  .filecard.oktober .badge { background: var(--oktober-dark); }
  .filecard.dreadnok .badge { background: var(--dreadnok-dark); }
  .filecard.cobra-la .badge { background: var(--cobra-la-dark); }

  .filecard h2 {
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 1.7rem;
    margin: 0 0 4px;
    letter-spacing: 0.5px;
  }

  .real-name {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin: 0 0 18px;
  }

  .real-name.unknown {
    font-style: italic;
    color: var(--text-muted);
  }

  .field-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 9px 0;
    border-bottom: 1px solid var(--panel-border);
    font-size: 0.9rem;
  }

  .field-row .label {
    font-family: 'Oswald', sans-serif;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-size: 0.72rem;
    color: var(--text-muted);
    flex-shrink: 0;
    padding-top: 2px;
  }

  .field-row .value { text-align: right; }

  .field-row .value.tbd {
    color: var(--text-muted);
    font-style: italic;
  }

  .bio-block { margin-top: 18px; }

  .bio-block h4 {
    font-family: 'Oswald', sans-serif;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-size: 0.72rem;
    color: var(--text-muted);
    margin: 0 0 8px;
  }

  .bio-block p {
    font-size: 0.9rem;
    line-height: 1.55;
    margin: 0;
  }
</style>
</head>
<body>

<header>
  <img src="images/gijoe-logo.jpg" alt="G.I. Joe: A Real American Hero" class="header-logo">
  
</header>

<div class="tabs">
  <button class="tab-btn active" data-tab="characters">Characters</button>
  <button class="tab-btn" data-tab="vehicles">Vehicles</button>
  <button class="tab-btn" data-tab="troops">Troop Types</button>
</div>

<!-- CHARACTERS TAB -->
<div class="tab-section active" id="tab-characters">
  <div class="controls">
    <input type="text" class="search-input" id="char-search" placeholder="Search by name or specialty...">
    <button class="filter-btn active" data-filter="all">All</button>
    <button class="filter-btn" data-filter="G.I. Joe">G.I. Joe</button>
    <button class="filter-btn" data-filter="Cobra">Cobra</button>
    <button class="filter-btn" data-filter="Oktober Guard">Oktober Guard</button>
    <button class="filter-btn" data-filter="Dreadnoks">Dreadnoks</button>
    <button class="filter-btn" data-filter="Cobra-La">Cobra-La</button>
  </div>
  <div class="grid" id="char-grid"></div>
</div>

<!-- VEHICLES TAB -->
<div class="tab-section" id="tab-vehicles">
  <div class="controls">
    <input type="text" class="search-input" id="vehicle-search" placeholder="Search by name or type...">
    <button class="filter-btn active" data-vfilter="all">All</button>
    <button class="filter-btn" data-vfilter="G.I. Joe">G.I. Joe</button>
    <button class="filter-btn" data-vfilter="Cobra">Cobra</button>
    <button class="filter-btn" data-vfilter="Dreadnoks">Dreadnoks</button>
  </div>
  <div class="grid" id="vehicle-grid"></div>
</div>

<!-- TROOP TYPES TAB -->
<div class="tab-section" id="tab-troops">
  <div class="controls">
    <input type="text" class="search-input" id="troop-search" placeholder="Search by name or role...">
    <button class="filter-btn active" data-tfilter="all">All</button>
    <button class="filter-btn" data-tfilter="Cobra">Cobra</button>
    <button class="filter-btn" data-tfilter="Cobra-La">Cobra-La</button>
  </div>
  <div class="grid" id="troop-grid"></div>
</div>

<div class="overlay" id="overlay">
  <div class="filecard" id="filecard"></div>
</div>

<script src="characters_data.js"></script>
<script src="vehicles_data.js"></script>
<script src="troops_data.js"></script>
<script>
  /* ---------- shared helpers ---------- */

  function factionClass(affiliation) {
    if (affiliation === 'Cobra') return 'cobra';
    if (affiliation === 'Oktober Guard') return 'oktober';
    if (affiliation === 'Dreadnoks') return 'dreadnok';
    if (affiliation === 'Cobra-La') return 'cobra-la';
    return 'joe';
  }

  function applyBodyFaction(affiliation) {
    document.body.classList.remove('bg-cobra', 'bg-oktober', 'bg-dreadnok', 'bg-cobra-la');
    if (affiliation === 'all' || !affiliation) return;
    const cls = factionClass(affiliation);
    if (cls !== 'joe') document.body.classList.add('bg-' + cls);
  }

  function thumbHtml(item, imgClass, boxClass) {
    if (item.image) {
      return `<img class="${imgClass}" src="${item.image}" alt="${item.name || item.codeName}">`;
    }
    return `<div class="${boxClass}">IMAGE</div>`;
  }

  function fieldRow(label, value) {
    if (value === 'N/A') {
      return '';
    }
    if (!value) {
      return `<div class="field-row"><span class="label">${label}</span><span class="value tbd">Needs verification</span></div>`;
    }
    return `<div class="field-row"><span class="label">${label}</span><span class="value">${value}</span></div>`;
  }

  function kiaRow(diedInAction) {
    if (!diedInAction) return '';
    return `<div class="field-row kia-row"><span class="label">Killed In Action</span><span class="value">${diedInAction}</span></div>`;
  }

  function toyDesignerRow(value) {
    if (!value) return '';
    return `<div class="field-row"><span class="label">Toy Designer</span><span class="value">${value}</span></div>`;
  }

  function closeCard() {
    document.getElementById('overlay').classList.remove('open');
  }

  document.getElementById('overlay').addEventListener('click', (e) => {
    if (e.target.id === 'overlay') closeCard();
  });

  /* ---------- tabs ---------- */

  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-section').forEach(s => s.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('tab-' + btn.dataset.tab).classList.add('active');
      if (btn.dataset.tab === 'characters') applyBodyFaction(charFilter);
      else if (btn.dataset.tab === 'vehicles') applyBodyFaction(vehicleFilter);
      else if (btn.dataset.tab === 'troops') applyBodyFaction(troopFilter);
    });
  });

  /* ---------- CHARACTERS ---------- */

  let charFilter = 'all';
  let charSearch = '';

  function renderCharGrid() {
    const grid = document.getElementById('char-grid');
    const filtered = CHARACTERS
      .filter(c => charFilter === 'all' || c.affiliation === charFilter)
      .filter(c => {
        if (!charSearch) return true;
        const t = charSearch.toLowerCase();
        return c.codeName.toLowerCase().includes(t) || (c.specialty || '').toLowerCase().includes(t);
      })
      .sort((a, b) => a.codeName.localeCompare(b.codeName));

    grid.innerHTML = filtered.map(c => {
      const cls = factionClass(c.affiliation);
      return `
        <div class="card ${cls}" onclick="openCharCard('${c.id}')">
          ${c.diedInAction ? '<span class="kia-ribbon">KIA</span>' : ''}
          <div class="card-text">
            <span class="badge">${c.affiliation}</span>
            <h3>${c.codeName}</h3>
            <p class="specialty">${c.specialty}</p>
          </div>
          ${thumbHtml(c, 'card-thumb-img', 'card-thumb')}
        </div>
      `;
    }).join('');
  }

  function openCharCard(id) {
    const c = CHARACTERS.find(ch => ch.id === id);
    if (!c) return;
    const cls = factionClass(c.affiliation);
    const isUnknown = c.realName === 'Classified';
    const isUnverified = c.realName === null;
    const realNameDisplay = isUnknown ? 'Name Unknown' : isUnverified ? 'Needs verification' : c.realName;

    const filecard = document.getElementById('filecard');
    filecard.className = `filecard ${cls}`;
    filecard.innerHTML = `
      <button class="close-btn" onclick="closeCard()">&times;</button>
      ${c.diedInAction ? '<span class="kia-ribbon">KIA</span>' : ''}
      <div class="filecard-top">
        <div class="filecard-heading">
          <span class="badge">${c.affiliation}</span>
          <h2>${c.codeName}</h2>
          <p class="real-name ${(isUnknown || isUnverified) ? 'unknown' : ''}">${realNameDisplay}</p>
        </div>
        ${thumbHtml(c, 'filecard-thumb-img', 'filecard-thumb')}
      </div>
      ${kiaRow(c.diedInAction)}
      ${fieldRow('Rank', c.rank)}
      ${fieldRow('Military Specialty', c.specialty)}
      ${fieldRow('First Comic Appearance', c.firstComicAppearance)}
      ${fieldRow('First Cartoon Appearance', c.firstCartoonAppearance)}
      ${fieldRow('Creators', c.creators)}
      ${toyDesignerRow(c.toyDesigner)}
      ${fieldRow('Equipment / Weapons', c.equipment)}
      <div class="bio-block">
        <h4>Bio</h4>
        <p>${c.bio || 'Needs verification'}</p>
      </div>
    `;
    document.getElementById('overlay').classList.add('open');
  }

  document.getElementById('char-search').addEventListener('input', (e) => {
    charSearch = e.target.value;
    renderCharGrid();
  });

  document.querySelectorAll('#tab-characters .filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#tab-characters .filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      charFilter = btn.dataset.filter;
      applyBodyFaction(charFilter);
      renderCharGrid();
    });
  });

  /* ---------- VEHICLES ---------- */

  let vehicleFilter = 'all';
  let vehicleSearch = '';

  function renderVehicleGrid() {
    const grid = document.getElementById('vehicle-grid');
    const filtered = VEHICLES
      .filter(v => vehicleFilter === 'all' || v.affiliation === vehicleFilter)
      .filter(v => {
        if (!vehicleSearch) return true;
        const t = vehicleSearch.toLowerCase();
        return v.name.toLowerCase().includes(t) || (v.vehicleType || '').toLowerCase().includes(t);
      })
      .sort((a, b) => a.name.localeCompare(b.name));

    grid.innerHTML = filtered.map(v => {
      const cls = factionClass(v.affiliation);
      return `
        <div class="card ${cls}" onclick="openVehicleCard('${v.id}')">
          <div class="card-text">
            <span class="badge">${v.affiliation}</span>
            <h3>${v.name}</h3>
            <p class="specialty">${v.vehicleType}</p>
          </div>
          ${thumbHtml(v, 'vehicle-card-thumb-img', 'vehicle-card-thumb')}
        </div>
      `;
    }).join('');
  }

  function openVehicleCard(id) {
    const v = VEHICLES.find(x => x.id === id);
    if (!v) return;
    const cls = factionClass(v.affiliation);

    const filecard = document.getElementById('filecard');
    filecard.className = `filecard ${cls}`;
    filecard.innerHTML = `
      <button class="close-btn" onclick="closeCard()">&times;</button>
      <div class="filecard-top">
        <div class="filecard-heading">
          <span class="badge">${v.affiliation}</span>
          <h2>${v.name}</h2>
          <p class="real-name">${v.fullName || v.vehicleType}</p>
        </div>
        ${thumbHtml(v, 'vehicle-filecard-thumb-img', 'vehicle-filecard-thumb')}
      </div>
      ${fieldRow('Type', v.vehicleType)}
      ${fieldRow('First Release Year', v.firstYear)}
      ${fieldRow('Crew', v.crew)}
      ${fieldRow('Armament', v.armament)}
      ${fieldRow('Packaged With', v.packagedWith)}
      ${toyDesignerRow(v.designer)}
      <div class="bio-block">
        <h4>Overview</h4>
        <p>${v.bio || 'Needs verification'}</p>
      </div>
    `;
    document.getElementById('overlay').classList.add('open');
  }

  document.getElementById('vehicle-search').addEventListener('input', (e) => {
    vehicleSearch = e.target.value;
    renderVehicleGrid();
  });

  document.querySelectorAll('#tab-vehicles .filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#tab-vehicles .filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      vehicleFilter = btn.dataset.vfilter;
      applyBodyFaction(vehicleFilter);
      renderVehicleGrid();
    });
  });

  /* ---------- TROOP TYPES ---------- */

  let troopFilter = 'all';
  let troopSearch = '';

  function renderTroopGrid() {
    const grid = document.getElementById('troop-grid');
    const filtered = TROOPS
      .filter(t => troopFilter === 'all' || t.affiliation === troopFilter)
      .filter(t => {
        if (!troopSearch) return true;
        const q = troopSearch.toLowerCase();
        return t.name.toLowerCase().includes(q) || (t.role || '').toLowerCase().includes(q);
      })
      .sort((a, b) => a.name.localeCompare(b.name));

    grid.innerHTML = filtered.map(t => {
      const cls = factionClass(t.affiliation);
      return `
        <div class="card ${cls}" onclick="openTroopCard('${t.id}')">
          <div class="card-text">
            <span class="badge">${t.affiliation}</span>
            <h3>${t.name}</h3>
            <p class="specialty">${t.role}</p>
          </div>
          ${thumbHtml(t, 'card-thumb-img', 'card-thumb')}
        </div>
      `;
    }).join('');
  }

  function openTroopCard(id) {
    const t = TROOPS.find(x => x.id === id);
    if (!t) return;
    const cls = factionClass(t.affiliation);

    const filecard = document.getElementById('filecard');
    filecard.className = `filecard ${cls}`;
    filecard.innerHTML = `
      <button class="close-btn" onclick="closeCard()">&times;</button>
      <div class="filecard-top">
        <div class="filecard-heading">
          <span class="badge">${t.affiliation}</span>
          <h2>${t.name}</h2>
          <p class="real-name">${t.fullName || t.role}</p>
        </div>
        ${thumbHtml(t, 'filecard-thumb-img', 'filecard-thumb')}
      </div>
      ${fieldRow('Role', t.role)}
      ${fieldRow('First Introduced', t.firstYear)}
      ${fieldRow('Equipment', t.equipment)}
      ${toyDesignerRow(t.toyDesigner)}
      <div class="bio-block">
        <h4>Overview</h4>
        <p>${t.bio || 'Needs verification'}</p>
      </div>
    `;
    document.getElementById('overlay').classList.add('open');
  }

  document.getElementById('troop-search').addEventListener('input', (e) => {
    troopSearch = e.target.value;
    renderTroopGrid();
  });

  document.querySelectorAll('#tab-troops .filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#tab-troops .filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      troopFilter = btn.dataset.tfilter;
      applyBodyFaction(troopFilter);
      renderTroopGrid();
    });
  });

  /* ---------- init ---------- */

  renderCharGrid();
  renderVehicleGrid();
  renderTroopGrid();
</script>

</body>
</html>
